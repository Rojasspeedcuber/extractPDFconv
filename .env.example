# Configurações da Aplicação PDF Extractor
PORT=3000
MAX_FILE_SIZE_MB=20
USE_MOCK_EXTRACTION=false
STORAGE_DIR=storage/temp

# --- Integração com banco de dados PostgreSQL ---
# URL de conexão do PostgreSQL. Substitua usuario, senha, host, porta e nome_do_banco.
# Exemplo real (DBeaver): postgresql://sica:SUA_SENHA@saojose2.recife:5432/dbpotemp_utf8
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Ativa (true) ou desativa (false) a gravação automática dos dados no banco.
# Se não for definida, fica ativa automaticamente quando houver DATABASE_URL.
PERSIST_TO_DB=true

# Futuras integrações (OCR, IA, Cloud Storage):
# GOOGLE_API_KEY=
# S3_BUCKET_NAME=
